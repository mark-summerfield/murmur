; Multiply A = A * B
A:      4
B:      7
C:      0
D:      0
E:      0
LOOP:   J(A, B, ENDA)
START:  J(B, C, ENDB)
        C(A, C)
ENDB:   S(E)
        J(B, E, ENDC)
        Z(D)
ENDD:   S(C)
        S(D)
        J(A, D, ENDB)
        J(ENDD)
ENDC:   C(C, A)
ENDA:   Z(B)
        Z(C)
        Z(D)
        Z(E)
        STOP
