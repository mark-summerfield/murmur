; Add 1 + 2; put result (3) in reg A (1) and clear regs B (2) and C (3)
*22 ; specify 22 registers (0..21; 0 is the program counter, PC)
A:	1 ; sets and labels next reg (1-based, starting from 1) to value; 1
B:	2 ; 2
C:	0 ; 3
START:	J(B, C, END) ; jump takes 4 regs; 4
	S(A) ; succ takes 2 regs; 8
	S(C) ; 10
	J(START) ; unconditional jump; psuedocode for J(1, 1, LABEL); 12
END:	Z(B) ; 16
	Z(C) ; 18
	STOP ; psuedocode for Z(PC), i.e., stop i.e., set PC in reg 0 to 0; 20
