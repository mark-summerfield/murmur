; selection sort (Sedgewick)
DATA:     86 11 17 55 38 96 21 36 23 60 19 0 31 94 53 68 7 1 6 26 76 45
CONT1:    66 37 5 58 90 70 34 41 40 3 12 57 51 28 61 24 47 15 13 63 97 72
CONT2:    14 88 29 80 95 46 92 99 83 42 49 67 16 98 54 64 81 89 91 18 4
CONT3:    82 33 87 10 77 78 43 50 2 73 75 93 22 79 71 84 25 56 65 9 74 44
CONT4:    32 69 85 39 59 48 35 27 62 52 30 8 20
R:        HERE
I:        1 ; set to first data register
J:        0
MIN:      0
TEMP:     0
START:    L(I, R, I_BODY) ; if I < R continue to loop
          J(END) ; else finish (i.e., finish outer (I) loop)
I_BODY:   C(I, MIN)
J_START:  C(I, J)
          S(J)
J_BODY:   J(J, R, J_INNER)
          L(J, R, J_INNER)
SWAP:     C(@I, TEMP) ; copy DATA[I] to TEMP
          C(@MIN, @I) ; copy DATA[MIN] to DATA[I]
          C(TEMP, @MIN) ; copy TEMP to DATA[MIN]
          J(I_END)
J_INNER:  L(@J, @MIN, SET_JMIN)
          J(J_END)
SET_JMIN: C(J, MIN)
J_END:    S(J)
          J(J_BODY)
I_END:    S(I)
          J(START)
END:      STOP
