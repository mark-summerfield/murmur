; Uses indirect addressing to loop over the DATA array adding 2 to each one
I:       2  ; 1
DATA:    1  ; before 1,  after 3  ; 2
3:       2  ; before 2,  after 4  ; 3
4:       3  ; before 3,  after 5  ; 4
5:       4  ; before 4,  after 6  ; 5
6:       5  ; before 5,  after 7  ; 6
7:       6  ; before 6,  after 8  ; 7
8:       7  ; before 7,  after 9  ; 8
9:       8  ; before 8,  after 10 ; 9
10:      9  ; before 9,  after 11 ; 10
11:      10 ; before 10, after 12 ; 11
ENDDATA: HERE ; 12
START:   J(I, ENDDATA, END)
         S(@I) 
         S(@I) 
         S(I)
         J(START)
END:     STOP
